# ==========================================
# AI CBT Exam Preparation System Configuration
# ==========================================

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=exam

# Embeddings Provider Configuration
# Supported providers: fastembed, sentence-transformers, openai, local
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Persistence Database Configuration
# SQLite (default MVP):
DATABASE_URL=sqlite:///cbt_exam.db

# PostgreSQL (production/docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbt_exam_db

# CBT Settings
DEFAULT_EXAM_DURATION_MINUTES=45
PASSING_PERCENTAGE=50.0
WEAK_TOPIC_THRESHOLD=60.0
COURSES_DIR=courses
